# fanqie-autopub-mcp 环境变量示例（都可省略，括号内是默认值）

# ---- 存储 ----
# 数据目录（默认：项目根/data）
# FANQIE_DATA_DIR=D:\番茄小说\fanqie-autopub-mcp\data
# 导出目录（默认：数据目录/export）
# FANQIE_EXPORT_DIR=D:\番茄小说\fanqie-autopub-mcp\data\export
# cookies 文件（默认：数据目录/tomato_cookies.json）
# FANQIE_COOKIES_FILE=D:\番茄小说\fanqie-autopub-mcp\data\tomato_cookies.json

# ---- 浏览器 ----
# 浏览器总开关：设为 0 / false 可彻底禁用浏览器能力（默认开启）
# FANQIE_ENABLE_BROWSER=1
# 用哪个浏览器（默认自动探测 本机 Chrome/Edge）
# FANQIE_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---- 后台地址（一般不用改）----
# FANQIE_AUTHOR_URL=https://fanqienovel.com/main/writer/login
# FANQIE_AUTHOR_API_BASE=https://fanqienovel.com
# FANQIE_CHAPTER_URL_TEMPLATE=https://fanqienovel.com/main/writer/{bookId}/publish/?enter_from=newchapter_1
# FANQIE_SHORT_MANAGE_URL=https://fanqienovel.com/main/writer/short-manage

# ---- 调试 ----
# FANQIE_DEBUG=1
